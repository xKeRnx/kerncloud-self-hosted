# Documentation only: node scripts/self-host.mjs init creates unique real values.
DEPLOYMENT_MODE=self-hosted
ALLOW_REGISTRATION=false
KERNCLOUD_COMPOSE_PROJECT=kerncloud-selfhost-example
KERNCLOUD_PORT=3100
KERNCLOUD_GATEWAY_PORT=3200
KERNCLOUD_DB_NAME=kerncloud
KERNCLOUD_IMAGE=kerncloud-selfhost:0.37.0
# Never paste this example as a working .env. Use local:init instead.
