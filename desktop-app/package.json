{
  "name": "kerncloud-desktop",
  "version": "0.43.0",
  "private": true,
  "homepage": "https://kern-ws.com",
  "desktopName": "kerncloud.desktop",
  "description": "KeRnCloud local workspace and Docker launcher",
  "main": "main.cjs",
  "license": "LicenseRef-KeRnCloud-Source-Available-1.0",
  "author": {
    "name": "KeRn-WS",
    "email": "support@kern-ws.com"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --check main.cjs && node --check renderer.js && node --check progress.js && node --check preload.cjs && node --check updates.cjs && node --test tests/*.test.cjs",
    "build": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.kern-ws.kerncloud.desktop",
    "productName": "KeRnCloud",
    "artifactName": "KeRnCloud-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.js",
      "progress.js",
      "index.html",
      "style.css",
      "policy.cjs",
      "package.json",
      "backend-runner.cjs",
      "docker-setup.cjs",
      "docker-install-linux.sh",
      "updates.cjs",
      "update-trust.json",
      "update-native.json",
      "connection.cjs"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE",
      "language": "1033",
      "installerLanguages": [
        "en_US",
        "de_DE"
      ],
      "displayLanguageSelector": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "maintainer": "KeRn-WS <support@kern-ws.com>"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
