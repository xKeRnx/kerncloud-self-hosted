{
  "name": "kerncloud-local",
  "version": "0.40.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "start:container": "next start --hostname 0.0.0.0 --port 3100",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.mjs",
    "test:runtime-tools": "node --import tsx scripts/test-runtime-tools.ts",
    "eval:context": "node --import tsx scripts/evaluate-runtime.ts",
    "eval:acceptance": "node --import tsx scripts/evaluate-acceptance.ts",
    "backup": "node scripts/backup.mjs",
    "infrastructure": "node --import tsx src/infrastructure/agent.ts",
    "setup:infrastructure": "node --env-file-if-exists=.env --import tsx scripts/setup-infrastructure.ts",
    "test:environment": "node --import tsx scripts/test-docker-environment.ts",
    "format": "prettier --write app components src scripts tests package.json tsconfig.json next.config.ts compose.yaml compose.worker.yaml README.md docs",
    "gateway": "node --env-file-if-exists=.env --import tsx src/gateway/server.ts",
    "scheduler": "node --env-file-if-exists=.env --import tsx src/scheduler.ts",
    "storage": "node --import tsx src/storage/server.ts",
    "storage:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate-object-storage.ts",
    "test:load": "node --env-file-if-exists=.env --import tsx scripts/load-test.ts",
    "local:init": "node scripts/self-host.mjs init",
    "local:doctor": "node scripts/self-host.mjs doctor",
    "local:start": "node scripts/self-host.mjs start",
    "local:stop": "node scripts/self-host.mjs stop",
    "local:status": "node scripts/self-host.mjs status",
    "local:backup": "node scripts/self-host.mjs backup",
    "local:update": "node scripts/self-host.mjs update",
    "release:check": "node scripts/release-check.mjs",
    "test:local": "node --test tests/self-host.test.mjs tests/local-process.test.mjs tests/image-distribution.test.mjs",
    "desktop:prepare": "node scripts/desktop-payload.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1153.0",
    "@fontsource/noto-sans": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.564.0",
    "next": "^16.2.0",
    "nodemailer": "10.1.7",
    "pdf-parse": "^2.4.5",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanitize-html": "^2.18.1",
    "stripe": "^23.0.0",
    "tsx": "^4.20.0",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  },
  "license": "LicenseRef-KeRnCloud-Source-Available-1.0"
}
